# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=6600
LOG_LEVEL=info

# Public origin of THIS service. Used to build /uploads URLs for downloaded
# media, and as the default host when registering a Telegram webhook.
# Must be https + publicly reachable for Telegram to deliver updates.
PUBLIC_BASE_URL=http://localhost:6600

# Comma-separated CORS origins, or * for all
ALLOWED_ORIGINS=*

# Max inbound JSON body size
REQUEST_BODY_LIMIT=5mb

# Max multipart upload size, in MB (Telegram bots cap sends at 50MB)
MAX_UPLOAD_MB=50

# ─── Telegram channel ──────────────────────────────────────────────────────
TELEGRAM_ENABLED=true

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Optional. If set, it is sent to Telegram on setWebhook and every inbound
# update is rejected unless X-Telegram-Bot-Api-Secret-Token matches.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Optional default used by POST /api/telegram/webhook/set when no url is given.
# Falls back to PUBLIC_BASE_URL + /api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Echo inbound messages back to the sender (testing aid; turn off in prod)
TELEGRAM_ECHO_INBOUND=true

TELEGRAM_TIMEOUT_MS=20000
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_FILE_API_BASE_URL=https://api.telegram.org
